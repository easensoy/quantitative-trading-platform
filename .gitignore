# Virtual environments
.venv/
venv/

# Secrets and machine-specific configuration
.env

# Python caches and build output
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# Datasets: only the small generated demo dataset (with its manifest) is tracked.
# Put downloaded or licensed market data elsewhere under data/; it stays local.
data/*
!data/demo/

# Runtime output
logs/
*.log
*.sqlite3
celerybeat-schedule*
celerybeat.pid
staticfiles/

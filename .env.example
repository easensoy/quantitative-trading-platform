# Copy to .env and adjust. quantcore/settings.py (Django) reads .env.
# The trading engine (run.py / main.py) does NOT read .env: set its variables in the
# shell instead, e.g. PowerShell:  $env:MODE = "backtest"  (see the engine section below).
# Never commit .env; it is listed in .gitignore.

# ---------------------------------------------------------------- Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_NAME=quantcore
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
# Seconds to keep database connections open between requests (0 = close after each).
DB_CONN_MAX_AGE=0
# Optional: replaces the DB_* settings entirely, e.g. SQLite for a run without PostgreSQL.
# DATABASE_URL=sqlite:///db.sqlite3

# Celery/Redis Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Django cache (django-redis) and Channels layer.
REDIS_URL=redis://localhost:6379/1
# redis (default) or locmem. DRF throttling uses the cache on every API request, so
# use locmem when Redis is not running.
CACHE_BACKEND=redis

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trading Configuration (Django TRADING_CONFIG; the engine reads the same names from
# the process environment)
MAX_POSITION_SIZE=1000000.0
MAX_PORTFOLIO_RISK=0.02
DEFAULT_COMMISSION=0.001
RISK_FREE_RATE=0.02
MARKET_DATA_PROVIDERS=yfinance

# Financial Data API Keys
BLOOMBERG_API_KEY=your-bloomberg-key
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
QUANDL_API_KEY=your-quandl-key
DATA_REFRESH_INTERVAL=300

# Logging
LOG_LEVEL=INFO
# Directory for quantcore.log (default: logs/ in the repository; created on startup).
# LOG_DIR=C:\path\to\logs

# Environment
ENVIRONMENT=development

# ---------------------------------------------------------------- Trading engine
# Process environment variables read by src/core/config.py (not loaded from .env).
# MODE=live                        # live | service | backtest (execution is always simulated)
# MARKET_DATA_PROVIDER=simulated   # simulated | yahoo (yahoo needs yfinance and internet)
# EVENT_BUS_TYPE=memory            # memory | redis (redis is incomplete, see README.md)
# INITIAL_CAPITAL=1000000          # starting cash for the engine portfolio and backtests
# MAX_POSITION_SIZE=1000000        # absolute share quantity per symbol checked before orders
# DEFAULT_COMMISSION=0.001         # commission rate applied to simulated fills
# SIMULATION_SEED=42               # fixes the simulated price sequence
# MARKET_DATA_POLL_INTERVAL=1.0    # seconds between quote polls
# RUN_DURATION_SECONDS=30          # stop live/service mode after N seconds (default: run until Ctrl+C)
# REDIS_HOST=localhost             # only used when EVENT_BUS_TYPE=redis
# REDIS_PORT=6379
